@baseUrl = http://127.0.0.1:8000

### Health
GET {{baseUrl}}/health

### Capabilities
GET {{baseUrl}}/capabilities

### Providers
GET {{baseUrl}}/providers

### Image presets
GET {{baseUrl}}/image/presets

### Generate audio
POST {{baseUrl}}/audio/generate
Content-Type: application/json

{
  "prompt": "A calm notification tone",
  "provider": "demo",
  "project": "youtube-test"
}

### Enhance narration
POST {{baseUrl}}/audio/enhance
Content-Type: application/json

{
  "input_path": "C:/media/narration.wav",
  "project": "episode-12"
}

### Generate SRT subtitles
POST {{baseUrl}}/audio/transcribe
Content-Type: application/json

{
  "input_path": "C:/media/video.mp4",
  "output_format": "srt",
  "model": "small",
  "project": "episode-12"
}

### Generate an image with a preset
POST {{baseUrl}}/image/generate
Content-Type: application/json

{
  "prompt": "a forest guardian with an ancient wooden mask",
  "preset": "game-character",
  "provider": "demo",
  "project": "forest-game"
}

### Batch image prompts
POST {{baseUrl}}/image/generate-batch
Content-Type: application/json

{
  "prompts": [
    "forest guardian portrait",
    "healing potion icon"
  ],
  "preset": "pixel-art",
  "provider": "demo",
  "project": "forest-game"
}

### Remove image background
POST {{baseUrl}}/image/remove-background
Content-Type: application/json

{
  "input_path": "C:/media/character.png",
  "model": "u2net",
  "project": "forest-game"
}

### Resize for vertical short
POST {{baseUrl}}/video/resize
Content-Type: application/json

{
  "input_path": "C:/media/highlight.mp4",
  "preset": "shorts",
  "project": "episode-12"
}

### Extract frames
POST {{baseUrl}}/video/frames
Content-Type: application/json

{
  "input_path": "C:/media/gameplay.mp4",
  "fps": 1,
  "project": "forest-game"
}
