@host = http://127.0.0.1:8000

### Health
GET {{host}}/health

### Models
GET {{host}}/models

### Workflows
GET {{host}}/workflows

### Queue thumbnail workflow
POST {{host}}/workflows/youtube.thumbnail
Content-Type: application/json

{
  "title": "BUILD AI VIDEOS LOCALLY",
  "prompt": "a creator in a futuristic local AI video studio, dramatic lighting, strong subject, empty space on the left",
  "project": "local-ai-video",
  "count": 4,
  "width": 1024,
  "height": 576,
  "steps": 20,
  "guidance": 4.5,
  "seed": 42,
  "subject_path": "C:/photos/creator.png"
}

### Queue direct Sana generation
POST {{host}}/jobs
Content-Type: application/json

{
  "kind": "model",
  "target": "image.sana-1.6b-int4",
  "payload": {
    "prompt": "a clean technology thumbnail background",
    "project": "thumbnail-test",
    "count": 2,
    "seed": 100
  }
}

### Queue SDXL inpainting
POST {{host}}/jobs
Content-Type: application/json

{
  "kind": "model",
  "target": "image.sdxl-inpaint",
  "payload": {
    "input_path": "C:/images/source.png",
    "mask_path": "C:/images/mask.png",
    "prompt": "replace the masked area with a clean studio desk",
    "project": "thumbnail-test"
  }
}

### Queue Kokoro narration
POST {{host}}/workflows/youtube.narration
Content-Type: application/json

{
  "text": "Welcome to my local AI media studio.",
  "project": "channel-intro",
  "model": "speech.kokoro",
  "voice": "af_heart",
  "normalize": true
}

### Queue social clip preparation
POST {{host}}/workflows/youtube.social-clip-prep
Content-Type: application/json

{
  "input_path": "C:/videos/source.mp4",
  "project": "episode-12",
  "preset": "shorts",
  "transcribe": true,
  "extract_fps": 0.2
}

### List jobs
GET {{host}}/jobs

### Get job
GET {{host}}/jobs/REPLACE_JOB_ID

### Cancel job
DELETE {{host}}/jobs/REPLACE_JOB_ID

### Unload active model
POST {{host}}/models/unload
