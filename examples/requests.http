@host = http://127.0.0.1:8000

### Readiness and storage
GET {{host}}/system/readiness
GET {{host}}/system/storage

### Audio presets
GET {{host}}/audio-ai/presets

### Generate preset music
POST {{host}}/audio-ai/music
Content-Type: application/json

{
  "prompt": "local AI creator episode",
  "preset": "technology-bed",
  "duration": 30,
  "project": "episode-01"
}

### Generate preset sound effect
POST {{host}}/audio-ai/sound-effect
Content-Type: application/json

{
  "prompt": "between two scenes",
  "preset": "soft-transition",
  "project": "episode-01"
}

### Generate resumable mixed AI Short
POST {{host}}/workflows/youtube.ai-short
Content-Type: application/json

{
  "script": "This Short was created entirely with local open-source AI.",
  "project": "local-ai-short",
  "music_prompt": "local AI creator story",
  "music_preset": "technology-bed",
  "scenes": [
    {
      "prompt": "a cinematic local AI workstation",
      "sfx_prompt": "scene transition",
      "sfx_preset": "interface-whoosh"
    },
    {
      "prompt": "a vertical timeline filled with generated media"
    }
  ],
  "use_motion": true,
  "fallback_to_stills": true
}

### List project runs
GET {{host}}/projects/runs?project=local-ai-short

### Inspect project run
GET {{host}}/projects/runs/REPLACE_PROJECT_RUN_ID

### Resume failed project run
POST {{host}}/projects/runs/REPLACE_PROJECT_RUN_ID/resume

### Preview project cleanup
POST {{host}}/system/cleanup
Content-Type: application/json

{
  "project": "local-ai-short",
  "include_project_runs": true
}

### Confirm project cleanup
POST {{host}}/system/cleanup
Content-Type: application/json

{
  "project": "local-ai-short",
  "include_project_runs": true,
  "dry_run": false,
  "confirm": true
}

### List jobs
GET {{host}}/jobs
