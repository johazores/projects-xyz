@host = http://127.0.0.1:8000

### Health and hardware
GET {{host}}/health

### Models and workflows
GET {{host}}/models
GET {{host}}/workflows

### Create cloned-voice consent
POST {{host}}/voices/consents
Content-Type: application/json

{
  "voice_name": "Channel host",
  "owner_name": "Voice owner",
  "reference_path": "C:/voices/host.wav",
  "usage_scope": "Local narration and podcast production",
  "confirmed": true
}

### Generate expressive speech
POST {{host}}/audio-ai/speech
Content-Type: application/json

{
  "text": "Welcome back to the channel [chuckle].",
  "model": "speech.chatterbox-turbo",
  "reference_path": "C:/voices/host.wav",
  "consent_id": "REPLACE_CONSENT_ID",
  "project": "episode-01"
}

### Generate ACE-Step music
POST {{host}}/audio-ai/music
Content-Type: application/json

{
  "prompt": "calm futuristic documentary music, instrumental",
  "duration": 30,
  "instrumental": true,
  "project": "episode-01"
}

### Generate Stable Audio sound effect
POST {{host}}/audio-ai/sound-effect
Content-Type: application/json

{
  "prompt": "clean cinematic technology transition whoosh",
  "duration": 3,
  "project": "episode-01"
}

### Generate mixed AI Short
POST {{host}}/workflows/youtube.ai-short
Content-Type: application/json

{
  "script": "This Short was created entirely with local open-source AI.",
  "project": "local-ai-short",
  "music_prompt": "subtle futuristic electronic background music, instrumental",
  "scenes": [
    {
      "prompt": "a cinematic local AI workstation",
      "sfx_prompt": "short digital interface whoosh"
    },
    {
      "prompt": "a vertical timeline filled with generated media"
    }
  ],
  "use_motion": true,
  "fallback_to_stills": true
}

### Generate podcast episode
POST {{host}}/workflows/youtube.podcast
Content-Type: application/json

{
  "title": "Local AI Creator Podcast",
  "project": "podcast-01",
  "music_prompt": "soft technology podcast music, instrumental",
  "segments": [
    {
      "speaker": "Host",
      "text": "Welcome to the show.",
      "tts_model": "speech.kokoro",
      "voice": "af_heart"
    },
    {
      "speaker": "Guest",
      "text": "Thanks for having me.",
      "tts_model": "speech.chatterbox-multilingual-v3",
      "language": "en",
      "reference_path": "C:/voices/guest.wav",
      "consent_id": "REPLACE_CONSENT_ID"
    }
  ]
}

### List jobs
GET {{host}}/jobs

### Get job
GET {{host}}/jobs/REPLACE_JOB_ID

### Cancel job
DELETE {{host}}/jobs/REPLACE_JOB_ID
