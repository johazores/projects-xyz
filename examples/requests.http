@host = http://127.0.0.1:8000

### Health
GET {{host}}/health

### Models
GET {{host}}/models

### Workflows
GET {{host}}/workflows

### Queue Kokoro narration
POST {{host}}/workflows/youtube.narration
Content-Type: application/json

{
  "text": "Welcome to my local AI media studio.",
  "project": "channel-intro",
  "model": "speech.kokoro",
  "voice": "af_heart",
  "normalize": true
}

### Queue social clip preparation
POST {{host}}/workflows/youtube.social-clip-prep
Content-Type: application/json

{
  "input_path": "C:/videos/source.mp4",
  "project": "episode-12",
  "preset": "shorts",
  "transcribe": true,
  "extract_fps": 0.2
}

### Queue a direct transcription model job
POST {{host}}/jobs
Content-Type: application/json

{
  "kind": "model",
  "target": "speech.faster-whisper",
  "payload": {
    "input_path": "C:/videos/source.mp4",
    "output_format": "srt",
    "project": "episode-12"
  }
}

### List jobs
GET {{host}}/jobs

### Get job
GET {{host}}/jobs/REPLACE_JOB_ID

### Cancel job
DELETE {{host}}/jobs/REPLACE_JOB_ID

### Unload active model
POST {{host}}/models/unload
