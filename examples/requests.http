@host = http://127.0.0.1:8000

### Health
GET {{host}}/health

### GPU diagnostics
GET {{host}}/system/gpu

### Benchmark history
GET {{host}}/system/benchmarks

### Models
GET {{host}}/models

### Workflows
GET {{host}}/workflows

### Queue direct Sana generation
POST {{host}}/image/generate
Content-Type: application/json

{
  "prompt": "a cinematic local AI workstation",
  "project": "image-test",
  "count": 2,
  "width": 1024,
  "height": 576,
  "seed": 42
}

### Queue multiple image prompts
POST {{host}}/image/generate-batch
Content-Type: application/json

{
  "prompts": [
    "a cinematic local AI workstation",
    "a vertical video editing timeline"
  ],
  "project": "image-batch",
  "width": 576,
  "height": 1024,
  "seed": 100
}

### Queue LTX text-to-video
POST {{host}}/video/generate
Content-Type: application/json

{
  "prompt": "slow cinematic movement through a futuristic local AI studio",
  "project": "video-test",
  "width": 576,
  "height": 320,
  "num_frames": 65,
  "steps": 20,
  "seed": 42
}

### Queue LTX image-to-video
POST {{host}}/video/generate
Content-Type: application/json

{
  "prompt": "subtle camera push-in and natural screen glow",
  "input_path": "C:/images/scene.png",
  "project": "video-test",
  "width": 320,
  "height": 576,
  "num_frames": 65,
  "steps": 20
}

### Queue AI Short workflow
POST {{host}}/workflows/youtube.ai-short
Content-Type: application/json

{
  "script": "This complete short is prepared using local open-source AI models.",
  "project": "local-ai-short",
  "scenes": [
    {
      "prompt": "a developer using a powerful local AI workstation",
      "text": "Start with a local script and narration"
    },
    {
      "prompt": "a vertical video timeline filled with generated images",
      "text": "Then assemble the final Short"
    }
  ],
  "use_motion": true,
  "fallback_to_stills": true
}

### Queue thumbnail workflow
POST {{host}}/workflows/youtube.thumbnail
Content-Type: application/json

{
  "title": "BUILD AI VIDEOS LOCALLY",
  "prompt": "a creator in a futuristic local AI video studio, dramatic lighting, empty space on the left",
  "project": "local-ai-video",
  "count": 4,
  "seed": 42
}

### List jobs
GET {{host}}/jobs

### Get job
GET {{host}}/jobs/REPLACE_JOB_ID

### Cancel job
DELETE {{host}}/jobs/REPLACE_JOB_ID

### Unload active model
POST {{host}}/models/unload
